<h1 class="mb-4">
Login
</h1>



<form method="POST" action="/login">


<div class="mb-3">


<label class="form-label">
Email
</label>


<input
type="email"
name="email"
class="form-control"
required>


</div>




<div class="mb-3">


<label class="form-label">
Password
</label>


<input
type="password"
name="password"
class="form-control"
required>


</div>




<button 
type="submit"
class="btn btn-primary">

Login

</button>



<a href="/register" class="btn btn-secondary">

Create Account

</a>


</form>