<h1 class="mb-4">
Login
</h1>



<form method="POST" action="/login">


<div class="mb-3">

<label>
Email
</label>


<input
type="email"
name="email"
class="form-control"
required>


</div>




<div class="mb-3">

<label>
Password
</label>


<input
type="password"
name="password"
class="form-control"
required>


</div>




<button class="btn btn-primary">

Login

</button>



</form>




<hr>




<h5>
Or continue with:
</h5>




<a href="/auth/github" class="btn btn-dark">

Continue with GitHub

</a>




<a href="/auth/google" class="btn btn-danger">

Continue with Google

</a>




<br><br>



<a href="/register">

Create new account

</a>