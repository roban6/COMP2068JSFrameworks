<h1 class="mb-4">
Edit Game
</h1>


<form method="POST" action="/games/{{game._id}}?_method=PUT">


<div class="mb-3">

<label class="form-label">
Game Title
</label>


<input
type="text"
name="title"
class="form-control"
value="{{game.title}}"
required>

</div>




<div class="mb-3">

<label class="form-label">
Platform
</label>


<input
type="text"
name="platform"
class="form-control"
value="{{game.platform}}"
required>

</div>




<div class="mb-3">

<label class="form-label">
Genre
</label>


<input
type="text"
name="genre"
class="form-control"
value="{{game.genre}}"
required>

</div>




<div class="mb-3">

<label class="form-label">
Release Year
</label>


<input
type="number"
name="releaseYear"
class="form-control"
value="{{game.releaseYear}}"
required>

</div>




<div class="mb-3">

<label class="form-label">
Completion Status
</label>


<select 
name="completionStatus"
class="form-select"
required>


<option value="Not Started">
Not Started
</option>


<option value="In Progress">
In Progress
</option>


<option value="Completed">
Completed
</option>


</select>


</div>




<div class="mb-3">

<label class="form-label">
Personal Rating
</label>


<input
type="number"
name="personalRating"
class="form-control"
min="1"
max="10"
value="{{game.personalRating}}"
required>

</div>




<button type="submit" class="btn btn-primary">

Update Game

</button>



<a href="/games" class="btn btn-secondary">

Cancel

</a>


</form>