<h1 class="mb-4">
Manage Games
</h1>



<a href="/dashboard/games/create"
class="btn btn-success mb-3">

Add New Game

</a>




<table class="table table-striped">


<thead>

<tr>

<th>
Title
</th>

<th>
Platform
</th>

<th>
Genre
</th>

<th>
Actions
</th>


</tr>


</thead>



<tbody>


{{#each games}}


<tr>


<td>
{{title}}
</td>


<td>
{{platform}}
</td>


<td>
{{genre}}
</td>


<td>


