<h1 class="mb-4">
Video Game Collection
</h1>



<form method="GET" action="/games" class="mb-4">


<div class="input-group">


<input

type="text"

name="search"

class="form-control"

placeholder="Search by title, platform, or genre"

value="{{search}}"


>


<button class="btn btn-primary">

Search

</button>


<a href="/games" class="btn btn-secondary">

Clear

</a>


</div>


</form>





<a href="/games/create" class="btn btn-success mb-3">

Add New Game

</a>





{{#if games.length}}



<table class="table table-striped">


<thead>


<tr>

<th>
Title
</th>


<th>
Platform
</th>


<th>
Genre
</th>


<th>
Actions
</th>


</tr>


</thead>




<tbody>



{{#each games}}



<tr>


<td>
{{title}}
</td>


<td>
{{platform}}
</td>


<td>
{{genre}}
</td>


<td>


<a href="/games/{{_id}}" class="btn btn-primary btn-sm">

View

</a>


<a href="/games/{{_id}}/edit" class="btn btn-warning btn-sm">

Edit

</a>


<a href="/games/{{_id}}/delete" class="btn btn-danger btn-sm">

Delete

</a>


</td>


</tr>



{{/each}}



</tbody>


</table>




{{else}}



<div class="alert alert-info">

No matching games found.

</div>



{{/if}}