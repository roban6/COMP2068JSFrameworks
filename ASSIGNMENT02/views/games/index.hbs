<h1 class="mb-4">
Video Game Collection
</h1>




<form method="GET" action="/games" class="mb-4">


<div class="input-group">


<input

type="text"

name="search"

class="form-control"

placeholder="Search games"

value="{{search}}"

>


<button class="btn btn-primary">

Search

</button>



<a href="/games" class="btn btn-secondary">

Clear

</a>


</div>


</form>





{{#if games.length}}



<table class="table table-striped">


<thead>


<tr>

<th>
Title
</th>


<th>
Platform
</th>


<th>
Genre
</th>


</tr>


</thead>




<tbody>



{{#each games}}


<tr>


<td>
{{title}}
</td>


<td>
{{platform}}
</td>


<td>
{{genre}}
</td>


</tr>



{{/each}}


</tbody>


</table>




{{else}}


<div class="alert alert-info">

No games found.

</div>


{{/if}}