<div class="d-flex justify-content-between align-items-center mb-4">


<h1>
Video Game Collection
</h1>


<a href="/games/create" class="btn btn-success">

Add New Game

</a>


</div>




{{#if games.length}}


<table class="table table-striped">


<thead>

<tr>

<th>
Title
</th>

<th>
Platform
</th>

<th>
Genre
</th>

<th>
Year
</th>

<th>
Status
</th>

<th>
Rating
</th>

</tr>

</thead>




<tbody>


{{#each games}}


<tr>


<td>
{{this.title}}
</td>


<td>
{{this.platform}}
</td>


<td>
{{this.genre}}
</td>


<td>
{{this.releaseYear}}
</td>


<td>
{{this.completionStatus}}
</td>


<td>
{{this.personalRating}}/10
</td>


</tr>


{{/each}}


</tbody>


</table>



{{else}}


<div class="alert alert-info">

No games available yet.

</div>


{{/if}}