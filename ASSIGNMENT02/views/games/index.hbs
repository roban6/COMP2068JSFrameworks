<h1>
Video Game Collection
</h1>


{{#if games.length}}

<table class="table table-striped">


<thead>

<tr>

<th>
Title
</th>


<th>
Platform
</th>


<th>
Genre
</th>


<th>
Year
</th>


<th>
Status
</th>


<th>
Rating
</th>

</tr>

</thead>



<tbody>


{{#each games}}


<tr>


<td>
{{this.title}}
</td>


<td>
{{this.platform}}
</td>


<td>
{{this.genre}}
</td>


<td>
{{this.releaseYear}}
</td>


<td>
{{this.completionStatus}}
</td>


<td>
{{this.personalRating}}/10
</td>


</tr>


{{/each}}


</tbody>


</table>


{{else}}


<p>
No games available yet.
</p>


{{/if}}