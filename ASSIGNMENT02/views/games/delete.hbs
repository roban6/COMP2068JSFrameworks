<h1>
Delete Game
</h1>


<div class="alert alert-danger">


<p>
Are you sure you want to delete:
<strong>
{{game.title}}
</strong>
?
</p>


</div>



<form method="POST" action="/games/{{game._id}}?_method=DELETE">


<button 
type="submit"
class="btn btn-danger">

Yes, Delete

</button>



<a href="/games" class="btn btn-secondary">

Cancel

</a>


</form>